# Copy to frontend/.env (or set in the shell / CI) — read at BUILD time by Vite.

# Which site to build/serve:
#   chart  = the Check Your Chart trading app (default when unset)
#   course = CYC Digital Academy course landing site (temporary, for payment-gateway approval)
VITE_SITE_MODE=chart

# Chart app only (defaults shown):
# VITE_API_URL=http://localhost:8000/api/v1
# VITE_WS_URL=ws://localhost:8000

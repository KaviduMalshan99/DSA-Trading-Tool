# Backend env — copy to backend/.env (read from the backend/ working dir, locally and in Docker).

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without it. In prod use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-prod
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Session cookie ─────────────────────────────────────────────────────────────
# Set false only for local http dev without HTTPS; keep true in prod.
# COOKIE_SECURE=false
# lax | strict | none ("none" requires COOKIE_SECURE=true).
# COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie; set e.g. .checkyourchart.net to share across subdomains.
# COOKIE_DOMAIN=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Defaults: http://localhost:5173, http://localhost:3000, https://checkyourchart.net
# Override with a JSON list, e.g.:
# CORS_ORIGINS=["http://localhost:5173","https://checkyourchart.net"]

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Optional — Google sign-in stays disabled unless all three GOOGLE_* are set.
# OAuth client ID from Google Cloud Console (Credentials → OAuth 2.0 Client IDs, type "Web application").
# GOOGLE_CLIENT_ID=
# Matching client secret — keep out of git.
# GOOGLE_CLIENT_SECRET=
# Exact callback URL registered with Google. Prod: https://checkyourchart.net/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the browser lands after sign-in, no trailing slash. Prod: https://checkyourchart.net
# FRONTEND_URL=http://localhost:5173

# ── Subscription ───────────────────────────────────────────────────────────────
# Price per period in LKR, at most 2 decimal places, > 0.
# SUBSCRIPTION_PRICE_LKR=1000.00
# Days of access bought by one payment.
# SUBSCRIPTION_DAYS=30
# Free trial for new accounts. migrations/004_subscriptions.sql hard-codes 7 for existing users; keep them in sync.
# TRIAL_DAYS=7
# Show the "ends in N days" banner when access ends within this many days.
# BANNER_DAYS=3
# Refuse checkout when access already runs more than this many days ahead.
# MAX_PREPAID_DAYS=90

# ── OnePay ─────────────────────────────────────────────────────────────────────
# Optional — payments stay disabled unless ONEPAY_APP_ID, ONEPAY_APP_TOKEN, ONEPAY_HASH_SALT
# and ONEPAY_RETURN_BASE_URL are all set. Values come from the OnePay merchant portal (APP section).
# ONEPAY_APP_ID=
# Sent as the Authorization header — keep out of git.
# ONEPAY_APP_TOKEN=
# Used in the request hash — keep out of git.
# ONEPAY_HASH_SALT=
# ONEPAY_BASE_URL=https://api.onepay.lk/v3
# Public HTTPS base of this API, no trailing slash; must start with https://.
# Prod: https://checkyourchart.net   Local: your tunnel URL, e.g. https://<random>.trycloudflare.com
# ONEPAY_RETURN_BASE_URL=

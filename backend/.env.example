# Backend env — copy to backend/.env (read from the backend/ working dir, locally and in Docker).

# ── Auth ───────────────────────────────────────────────────────────────────────
# REQUIRED — the app refuses to start without it. In prod use a long random value:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-in-prod
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Session cookie ─────────────────────────────────────────────────────────────
# Set false only for local http dev without HTTPS; keep true in prod.
# COOKIE_SECURE=false
# lax | strict | none ("none" requires COOKIE_SECURE=true).
# COOKIE_SAMESITE=lax
# Leave empty for a host-only cookie; set e.g. .checkyourchart.net to share across subdomains.
# COOKIE_DOMAIN=

# ── CORS ───────────────────────────────────────────────────────────────────────
# Defaults: http://localhost:5173, http://localhost:3000, https://checkyourchart.net
# Override with a JSON list, e.g.:
# CORS_ORIGINS=["http://localhost:5173","https://checkyourchart.net"]

# ── Google OAuth ───────────────────────────────────────────────────────────────
# Optional — Google sign-in stays disabled unless all three GOOGLE_* are set.
# OAuth client ID from Google Cloud Console (Credentials → OAuth 2.0 Client IDs, type "Web application").
# GOOGLE_CLIENT_ID=
# Matching client secret — keep out of git.
# GOOGLE_CLIENT_SECRET=
# Exact callback URL registered with Google. Prod: https://checkyourchart.net/api/v1/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Where the browser lands after sign-in, no trailing slash. Prod: https://checkyourchart.net
# FRONTEND_URL=http://localhost:5173
